# Dependencies
node_modules/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# SQLite (derived, disposable)
*.db
*.db-journal
*.db-wal
*.db-shm

# Schist vault derived data
.schist/

# Viewer build output
viewer/static/data/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment
.env
.env.local

# Local-only npm overrides (e.g. HPC python path for better-sqlite3 source build)
.npmrc

# Pre-receive hook audit log (runtime-generated). Both spellings were anchored
# to a directory; the log's default path is $GIT_DIR/hooks/, which follows
# GIT_DIR anywhere — same trap as rate-limits.sqlite below (#525).
rejected-pushes.log

# Personal agent tooling (speckit framework + handoff skill — not part of schist)
.specify/
.claude/skills/speckit-*/
.claude/skills/handoff/
.gstack/
.claude/

# Test-run residue: rate_limit.py defaults its DB to $GIT_DIR/rate-limits.sqlite,
# falling back to the CWD when GIT_DIR is unset — so it lands in cli/ when tests
# run from there and in the repo root when they run from here (#525; it was
# committed once already). No leading slash: ignore it at any depth.
rate-limits.sqlite
