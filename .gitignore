# Dependencies
node_modules/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# SQLite (derived, disposable)
*.db
*.db-journal
*.db-wal
*.db-shm

# Schist vault derived data
.schist/

# Viewer build output
viewer/static/data/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment
.env
.env.local

# Local-only npm overrides (e.g. HPC python path for better-sqlite3 source build)
.npmrc

# Pre-receive hook audit log (runtime-generated)
hooks/rejected-pushes.log
cli/hooks/rejected-pushes.log

# Personal agent tooling (speckit framework + handoff skill — not part of schist)
.specify/
.claude/skills/speckit-*/
.claude/skills/handoff/
.gstack/
.claude/

# Test-run residue: rate_limit.py defaults its DB to $GIT_DIR/rate-limits.sqlite,
# which lands in cli/ when tests run without GIT_DIR (same trap as cli/hooks/).
cli/rate-limits.sqlite
